{
  "name": "learncsharp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "capture": "cd .. && dotnet run --project src/LearnCSharp.Lessons -- capture web/public/data",
    "dev": "npm run capture && npm run content && vite",
