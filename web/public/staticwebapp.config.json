{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/data/*"]
  },
  "globalHeaders": {
    "cache-control": "public, max-age=3600, must-revalidate"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/sw.js",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}
